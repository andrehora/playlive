{
  "name": "playlive",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Run end-to-end tests live in the browser",
  "scripts": {
    "start": "node tests/server.mjs 4174",
    "serve": "node tests/server.mjs 4173",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:css": "stylelint \"**/*.css\"",
    "lint:css:fix": "stylelint \"**/*.css\" --fix",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "node --test \"tests/unit/*.test.mjs\"",
    "test:unit:watch": "node --test --watch \"tests/unit/*.test.mjs\"",
    "test:e2e": "playwright test",
    "test:examples": "playwright test examples.spec.js",
    "test:app": "playwright test app.spec.js",
    "test:headed": "playwright test --headed",
    "test:report": "playwright show-report"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.56.0",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "js-yaml": "4.1.0",
    "jsdom": "^29.1.1",
    "stylelint": "^17.16.0",
    "stylelint-config-standard": "^40.0.0"
  }
}
